{
  "name": "vanta",
  "version": "2.1.2",
  "private": true,
  "description": "Vanta Personal Cinema: a media library viewer (not a manager) for Plex. Browse and watch your own Plex library.",
  "author": "soybean_alien",
  "license": "GPL-3.0-only",
  "homepage": "https://github.com/soybean-alien/vanta-personal-cinema",
  "repository": {
    "type": "git",
    "url": "https://github.com/soybean-alien/vanta-personal-cinema.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "build": "vite build",
    "start": "vite build && electron .",
    "demo": "vite build && electron . --demo",
    "typecheck": "tsc --noEmit",
    "dist": "vite build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "com.soybeanalien.vanta",
    "productName": "Vanta",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/mpv",
        "to": "mpv"
      },
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "soybean-alien",
        "repo": "vanta-personal-cinema",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vanta",
      "artifactName": "Vanta-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "@fontsource-variable/jost": "^5.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
